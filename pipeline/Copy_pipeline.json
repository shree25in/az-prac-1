{
	"name": "Copy_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select distinct watermarkvalue from dbo.controltable where sourcefilename = 'daily_exp';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "src_lkp",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MySqlSource",
						"query": "select max(id) as id from exptrk.daily_exp;"
					},
					"dataset": {
						"referenceName": "MySqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "src_lkp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(\n    int(activity('src_lkp').output.firstRow.id), \n    int(activity('lookup').output.firstRow.watermarkvalue))\n",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Data copy_copy1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "`daily_exp`"
								},
								{
									"name": "Destination",
									"value": "chocodtls/daily_exp/"
								}
							],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "select * from exptrk.daily_exp where id > @{activity('lookup').output.firstRow.watermarkvalue}",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"name": "id",
												"type": "Int32",
												"physicalType": "Int32"
											},
											"sink": {
												"name": "id",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "date",
												"type": "DateTime",
												"physicalType": "Date"
											},
											"sink": {
												"name": "date",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "income",
												"type": "Decimal",
												"physicalType": "NewDecimal"
											},
											"sink": {
												"name": "income",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "shop",
												"type": "String",
												"physicalType": "VarChar"
											},
											"sink": {
												"name": "shop",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "item_type",
												"type": "String",
												"physicalType": "VarChar"
											},
											"sink": {
												"name": "item_type",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "items",
												"type": "String",
												"physicalType": "VarChar"
											},
											"sink": {
												"name": "items",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "bill_amount",
												"type": "Decimal",
												"physicalType": "NewDecimal"
											},
											"sink": {
												"name": "bill_amount",
												"type": "String",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "comments",
												"type": "String",
												"physicalType": "VarChar"
											},
											"sink": {
												"name": "comments",
												"type": "String",
												"physicalType": "String"
											}
										}
									],
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "MySqlTable1",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DelimitedText1",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "UpdateWatermark_Proc",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[UpdateWatermark]",
								"storedProcedureParameters": {
									"NewID": {
										"value": {
											"value": "@activity('src_lkp').output.firstRow.id",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"SourceName": {
										"value": "daily_exp",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}